{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": [
    "env.d.ts",
    "src/**/*",
    "src/**/*.vue",
    "mock/**/*",
    "vitest.setup.ts",
    "vitest.browser.setup.ts"
  ],
  "exclude": ["src/**/__tests__/**"],
  "compilerOptions": {
    "noUncheckedIndexedAccess": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
